

import tkinter as tk
import os
from dotenv import load_dotenv

# Cargar las variables de entorno desde el archivo .env
load_dotenv()

APP_USER = os.getenv("APP_USER")
APP_PASSWORD = os.getenv("APP_PASSWORD")


# FUNCION 1: Capturar las credenciales
def capturar_credenciales():
    usuario = entrada_usuario.get()
    contraseña = entrada_password.get()

    validar_credenciales(usuario, contraseña)


# FUNCION 2: Validar las credenciales
def validar_credenciales(usuario, contraseña):

    if usuario == APP_USER and contraseña == APP_PASSWORD:
        mostrar_mensaje("Acceso correcto", "green")
    else:
        mostrar_mensaje("Credenciales incorrectas", "red")


# FUNCION 3: Mostrar el mensaje en pantalla
def mostrar_mensaje(mensaje, color):
    etiqueta_resultado.config(text=mensaje, fg=color)


# CREAR VENTANA PRINCIPAL
ventana = tk.Tk()
ventana.title("Validacion de Credenciales")
ventana.geometry("420x320")
ventana.resizable(False, False)
ventana.configure(bg="#F2F4F4")


# TITULO
titulo = tk.Label(
    ventana,
    text="SISTEMA DE INICIO DE SESION",
    font=("Arial", 15, "bold"),
    bg="#F2F4F4",
    fg="#17202A"
)
titulo.pack(pady=25)


# CAMPO DE USUARIO
tk.Label(
    ventana,
    text="Usuario:",
    font=("Arial", 11),
    bg="#F2F4F4"
).pack()

entrada_usuario = tk.Entry(
    ventana,
    width=32,
    font=("Arial", 11)
)
entrada_usuario.pack(pady=7)


# CAMPO DE CONTRASEÑA
tk.Label(
    ventana,
    text="Contraseña:",
    font=("Arial", 11),
    bg="#F2F4F4"
).pack()

entrada_password = tk.Entry(
    ventana,
    width=32,
    font=("Arial", 11),
    show="*"
)
entrada_password.pack(pady=7)


# BOTON DE INICIO DE SESION
boton = tk.Button(
    ventana,
    text="Iniciar sesión",
    command=capturar_credenciales,
    bg="#2471A3",
    fg="white",
    font=("Arial", 10, "bold"),
    width=18,
    cursor="hand2"
)
boton.pack(pady=18)


# ETIQUETA PARA MOSTRAR LOS RESULTADOS
etiqueta_resultado = tk.Label(
    ventana,
    text="",
    font=("Arial", 12, "bold"),
    bg="#F2F4F4"
)
etiqueta_resultado.pack(pady=5)


# EJECUTAR LA APLICACION
ventana.mainloop()
